# Supabase externo (público, usado no navegador)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Somente servidor (nunca exponha)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Asaas (fallback se o negócio não tiver chave própria)
ASAAS_API_KEY=
# sandbox ou production
ASAAS_ENV=sandbox
