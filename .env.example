# Supabase externo (público, usado no navegador)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Somente servidor (nunca exponha). No Lovable o prefixo SUPABASE_ é reservado em Secrets,
# por isso a chave de serviço se chama SB_SERVICE_ROLE_KEY.
SUPABASE_URL=https://xxxx.supabase.co
SB_SERVICE_ROLE_KEY=eyJ...

# Asaas (fallback se o negócio não tiver chave própria)
ASAAS_API_KEY=
# sandbox ou production
ASAAS_ENV=sandbox
# Segredo do webhook de pagamento: 32+ caracteres, o mesmo cadastrado no painel do Asaas
# (o Asaas envia no cabeçalho asaas-access-token). URL do webhook: https://SEU-SITE/api/asaas-webhook
ASAAS_WEBHOOK_TOKEN=

# Mensalidade dos planos: conta Asaas DA PLATAFORMA (separada da chave de cada negócio).
# Cadastre em Lovable > Settings > Secrets (nunca no repositório).
# PLATFORM_ASAAS_API_KEY=
# PLATFORM_ASAAS_ENV=production   # sem isso vale ASAAS_ENV; "production" ou sandbox
# PUBLIC_SITE_URL=https://confirmazap.lovable.app   # opcional: endereço usado nos links do WhatsApp
